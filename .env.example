# Production uses Firebase. Use mock only for local development.
EXPO_PUBLIC_DATA_MODE=firebase

# Firebase web app configuration. Set all values to use Firestore.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Browser key restricted to your web origins; enables the Maps JavaScript Places library.
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# Android/iOS restricted key for the native Places API (New) REST implementation.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Android/iOS map key restricted to Maps SDK for Android and Maps SDK for iOS.
EXPO_PUBLIC_GOOGLE_MAPS_NATIVE_API_KEY=

# Cloudinary uploads: server-side variables only. NEVER prefix secrets with EXPO_PUBLIC_.
# Keep the Cloudinary account on Free, with no paid upgrade.
FIREBASE_PROJECT_ID=the-list-78f2b
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Enable only after configuring the Free account. Set false to pause new uploads.
CLOUDINARY_UPLOADS_ENABLED=false

# Public origin of the Vercel API. Optional for same-origin web; required on native.
# Local Expo web also needs an API origin (or a local API proxy).
EXPO_PUBLIC_UPLOAD_API_URL=
# Optional exact browser origins for a separate local API. Empty on same-origin Vercel.
# CLOUDINARY_BROWSER_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
