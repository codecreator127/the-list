{
  "name": "the-list",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export -p web",
    "preview": "node scripts/preview-web.mjs",
    "start": "expo start --offline",
    "start:online": "expo start",
    "android": "expo start --offline --android",
    "ios": "expo start --offline --ios",
    "web": "expo start --offline --web",
    "typecheck": "tsc --noEmit",
    "verify:firestore": "firebase emulators:exec --project demo-the-list --only auth,firestore,storage \"node scripts/verify-firestore-schema.mjs\"",
    "test:ratings": "tsx --test features/ratings.test.ts",
    "test:v1": "tsx --test features/v1.test.ts",
    "verify:v1": "firebase emulators:exec --project demo-the-list --only auth,firestore,storage \"tsx scripts/verify-v1.mjs\"",
    "migrate:ratings": "tsx scripts/migrate-ratings.ts",
    "seed:dry-run": "tsx scripts/seed.mjs dry-run",
    "seed": "tsx scripts/seed.mjs seed",
    "seed:verify": "tsx scripts/seed.mjs verify",
    "seed:cleanup": "tsx scripts/seed.mjs cleanup",
    "test:seed": "tsx --test scripts/seed.test.mjs",
    "test:seed:emulator": "firebase emulators:exec --project demo-list-seed-guards --only auth,firestore \"tsx scripts/seed-emulator.test.mjs\"",
    "test:photos": "node --test server/profile-photo.test.mjs server/photo-budget.test.mjs",
    "uploads:check": "node --env-file=.env scripts/check-cloudinary.mjs",
    "uploads:smoke": "node --env-file=.env scripts/smoke-profile-photo.mjs",
    "uploads:dev": "node --env-file=.env scripts/serve-uploads.mjs",
    "test:review-photos": "tsx --test features/reviewPhotoLifecycle.test.ts",
    "test:combined": "tsx --test features/combinedList.test.ts services/combinedListData.test.ts"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.46",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.21",
    "expo-status-bar": "~2.0.1",
    "firebase": "^12.19.0",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-maps": "1.18.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "tsx": "^4.23.15",
    "typescript": "~5.3.3"
  }
}
